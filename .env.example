# Optional: exit link to the host portfolio/blog. Default opens NeuroLab article.
# VITE_EXIT_URL=/blog/

# Optional: override the asset directory (include trailing slash).
# Default: import.meta.env.BASE_URL + assets/lab-v1/
# VITE_ASSET_BASE_URL=/blog/llm/assets/lab-v1/

# Optional public verification tokens. Configure these in Vercel Production
# environment variables and redeploy. Empty values emit no verification tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
