{
  "name": "neurolab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "NeuroLab: dunia 3D berbahasa Indonesia untuk memahami LLM dengan menyentuh mesinnya, dengan decoder mini sungguhan yang berjalan di browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/world3d-browser-check.mjs",
    "check": "tsc --noEmit && node --test tests/*.test.mjs && vite build --logLevel error && node scripts/world3d-browser-check.mjs",
    "model:train": "python scripts/train-story-model.py",
    "format": "prettier --write src scripts tests vite.config.ts"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "lucide-react": "0.577.0",
    "postprocessing": "6.39.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.169.0",
    "zustand": "5.0.8"
  }
}
