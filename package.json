{
  "name": "neurolab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NeuroLab: interactive Indonesian LLM learning observatory with deterministic toy Transformer and original 3D assets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender-article.mjs",
    "check": "tsc --noEmit && node --test tests/*.test.mjs && vite build --logLevel error && node scripts/prerender-article.mjs && node scripts/browser-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "fixtures:generate": "node scripts/build-fixtures.mjs",
    "assets:generate": "node scripts/generate-lab-assets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:preview": "node scripts/preview-server.mjs",
    "format": "prettier --write src scripts tests vite.config.ts"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "axe-core": "4.13.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "katex": "0.16.45",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.1.13",
    "zustand": "5.0.8",
    "three": "0.169.0"
  }
}
