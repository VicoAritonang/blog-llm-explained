{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {"source":"/","destination":"/id/","permanent":true},
    {"source":"/id/index.html","destination":"/id/","permanent":true},
    {"source":"/en/index.html","destination":"/en/","permanent":true}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
    {"source":"/content/(.*)","headers":[{"key":"Content-Type","value":"text/markdown; charset=utf-8"},{"key":"X-Robots-Tag","value":"noindex"}]},
    {"source":"/sitemap.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"}]},
    {"source":"/robots.txt","headers":[{"key":"Content-Type","value":"text/plain; charset=utf-8"}]},
    {"source":"/llms.txt","headers":[{"key":"Content-Type","value":"text/plain; charset=utf-8"}]},
    {"source":"/llms-full.txt","headers":[{"key":"Content-Type","value":"text/plain; charset=utf-8"}]}
  ]
}
